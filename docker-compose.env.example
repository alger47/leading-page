# docker-compose.yml environment template (Phase 15).
#   cp docker-compose.env.example .env
# Then replace every "change-me" value. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the resulting .env (.gitignore already blocks it).

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=landing_ai

# --- Internal service tokens (must be real in production) -------------------
# worker -> engine
AI_INTERNAL_TOKEN=change-me-32-bytes-random-hex
# web -> worker
WORKER_INTERNAL_TOKEN=change-me-different-32-bytes-random-hex

# --- LLM provider (stub needs no key) --------------------------------------
AI_PROVIDER=stub
# AI_PROVIDER=openai
# AI_OPENAI_API_KEY=
# AI_OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Web / published-page domain -------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_HOST_SUFFIX=landing-ai.test
# Set to 1 when the stack is behind a TLS reverse proxy.
COOKIE_SECURE=0
WEB_PORT=3000

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1
