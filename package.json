{
  "name": "landing-ai-platform",
  "version": "0.0.1",
  "private": true,
  "description": "AI-powered landing page generation platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "qa": "node scripts/qa.mjs",
    "qa:update": "node scripts/qa.mjs --update",
    "codegen": "turbo codegen",
    "prepare": "husky install"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "husky": "^9.0.0"
  }
}
