# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landing_ai

# Redis
# Set REDIS_URL=memory:// for local dev without a Redis server (worker uses the
# in-memory queue driver; BullMQ + real Redis remains the production path).
REDIS_URL=redis://localhost:6379

# AI Engine
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=dev-internal-key-change-me

# LLM Providers (selected during Phase 4)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Image providers
# STABILITY_API_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_ROOT_DOMAIN=localhost:3000
# Web application
WORKER_URL=http://localhost:8080
