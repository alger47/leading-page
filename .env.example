# Leading Page AI — environment template (copy to .env; never commit real values).
# Per-service templates live next to each app:
#   apps/web/.env.example, apps/worker/.env.example,
#   packages/database/.env.example, apps/ai-engine/.env.example
# See docs/production-readiness.md for the production matrix and runbook.

# Runtime mode. `production` enables fail-closed guards and Secure cookies.
NODE_ENV=development

# ------------------------------------------------------------------ Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landing_ai

# -------------------------------------------------------------------- Redis
# REDIS_URL=memory:// runs the worker on the in-memory queue driver (no Redis
# process needed for local dev). BullMQ + real Redis is the production path.
REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------- AI Engine
AI_ENGINE_URL=http://localhost:8000
# Internal token the worker presents to the engine (X-Internal-Token).
# Must match the engine's AI_INTERNAL_TOKEN. Production requires a real secret.
AI_INTERNAL_TOKEN=dev-internal-token

# A second, distinct internal token: the web app's workers' API token.
# Must match apps/worker WORKER_INTERNAL_TOKEN. Production requires a real secret.
WORKER_INTERNAL_TOKEN=dev-worker-token

# LLM providers (selected during Phase 4; the engine stub needs no key)
# AI_OPENAI_API_KEY=
# AI_ANTHROPIC_API_KEY=
# AI_GEMINI_API_KEY=
# AI_QWEN_API_KEY=

# --------------------------------------------------------------- Web / worker
# Web -> worker API base URL.
WORKER_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Published-page host mapping: a valid page is served at
# `${PUBLIC_BASE_URL}/${host}` with host = p-<pageTail>.<PUBLIC_HOST_SUFFIX>.
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_HOST_SUFFIX=landing-ai.test

# Session cookie
# SESSION_TTL_DAYS=30
# SESSION_COOKIE_NAME=sid
# CSRF_COOKIE_NAME=csrf
# Secure cookie flag. Omitted => true in production, false otherwise.
# COOKIE_SECURE=1

# ------------------------------------------------- Asset storage (GAP-6)
# ASSET_STORAGE_DRIVER=local            # local | s3
# ASSET_STORAGE_DIR=./.local-assets
# NEXT_PUBLIC_ASSET_S3_BASE_URL=https://cdn.example.com/assets
# ASSET_S3_BUCKET=landing-ai-assets
# ASSET_S3_REGION=us-east-1
# ASSET_S3_ACCESS_KEY_ID=
# ASSET_S3_SECRET_ACCESS_KEY=
# ASSET_S3_ENDPOINT=
# ASSET_S3_URL_TTL_SECONDS=900

# ------------------------------------------------- API hardening (GAP-6)
# RATE_LIMIT_CAPACITY=60
# RATE_LIMIT_REFILL_PER_SECOND=1
# RATE_LIMIT_DISABLED=0

# ------------------------------------------------- Backups (GAP-6)
# BACKUP_RETENTION=7
# BACKUP_DIR=backups
# PG_DUMP_BIN=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
