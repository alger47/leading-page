{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayoutPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["ordering", "layoutHints", "theme"],
  "properties": {
    "ordering": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sectionId", "order"],
        "properties": {
          "sectionId": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "layoutHints": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "columns": { "type": "integer", "minimum": 1, "maximum": 4 },
          "align": { "type": "string", "enum": ["start", "center", "end"] }
        }
      }
    },
    "theme": {
      "type": "string",
      "enum": ["warm-professional", "cool-modern", "bold-creative", "minimal-clean"]
    }
  }
}