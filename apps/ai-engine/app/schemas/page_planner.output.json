{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SectionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "rationale"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "variant", "slots"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
          "type": {
            "type": "string",
            "enum": ["header", "hero", "features", "testimonials", "pricing", "faq", "gallery", "contact", "cta", "footer"]
          },
          "variant": { "type": "string", "minLength": 1, "maxLength": 40 },
          "slots": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 400 }
  }
}