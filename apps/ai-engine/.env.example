# AI Engine configuration (prefix: AI_).
# Copy to .env and adjust. Never commit a real token.

# Service identity
AI_ENV=development
AI_SERVICE_NAME=ai-engine
AI_VERSION=0.1.0

# Internal auth (Worker -> AI Engine boundary). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_INTERNAL_TOKEN=dev-internal-token

# Default provider for model classes not pinned in routing config
AI_PROVIDER=stub            # stub | openai | anthropic

# Model routing (PART VI §6.3)
AI_ROUTING_CONFIG_PATH=config/routing.yaml

# L0 brief validation caps (PART VIII §8.1)
AI_MAX_BRIEF_LENGTH=4000

# Job-level bounds (PART VI §6.5/§6.9)
AI_JOB_MAX_TOTAL_ATTEMPTS=18
AI_JOB_DEFAULT_BUDGET_USD=0.25

# Mini-eval acceptance target (PART IX §9.2)
AI_EVAL_MIN_VALIDITY=0.99

# Canonical Page Schema contracts (ADR-0002 single source of truth).
# Defaults to packages/page-schema/schema in the monorepo; override only when
# the engine runs without the monorepo checkout.
# AI_PAGE_SCHEMA_DIR=../../packages/page-schema/schema

# HTTP provider credentials (leave empty; tests/dev use the stub)
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local Ollama (OpenAI-compatible endpoint; keyless). Leave empty to use stub.
AI_OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Optional: free cloud LLM tier (Groq, OpenAI-compatible) ----------------
#  1. Get a free key (no card) at https://console.groq.com  (starts with gsk_)
#  2. AI_OPENAI_API_KEY=<your gsk_... key>
#  3. AI_OPENAI_BASE_URL=https://api.groq.com/openai/v1
#  4. Point routing at a local (uncommitted) openai config instead of editing
#     the committed stub defaults:
#       AI_ROUTING_CONFIG_PATH=config/routing.local.yaml
#     (create it with:   powershell -ExecutionPolicy Bypass -File scripts/flip-groq.ps1)
#  5. Restart the AI Engine. The page/UI then shows real copy under
#     generation_mode=llm (the "demonstration mode" banner disappears).
#
# Free-tier notes (2026): ~30 req/min, ~500K tokens/day per key; model IDs
# llama-3.1-8b-instant / llama-3.3-70b-versatile are DEPRECATED on Groq.
# Use openai/gpt-oss-20b (fast) and openai/gpt-oss-120b or qwen/qwen3.6-27b
# (premium). Verify structured-output (response_format JSON Schema) support on
# console.groq.com/docs/models before switching premium.
#
# Phase 13: also route ONLY the brief analyzer through an LLM (vertical/tone/
# inference) while content stays on your configured models:
# AI_BRIEF_ANALYZER_LLM=true
# (requires AI_OPENAI_API_KEY set; brief-llm model is pinned in routing.yaml)