# AI Engine configuration (prefix: AI_).
# Copy to .env and adjust. Never commit a real token.

# Service identity
AI_ENV=development
AI_SERVICE_NAME=ai-engine
AI_VERSION=0.1.0

# Internal auth (Worker -> AI Engine boundary). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_INTERNAL_TOKEN=dev-internal-token

# Default provider for model classes not pinned in routing config
AI_PROVIDER=stub            # stub | openai | anthropic

# Model routing (PART VI §6.3)
AI_ROUTING_CONFIG_PATH=config/routing.yaml

# L0 brief validation caps (PART VIII §8.1)
AI_MAX_BRIEF_LENGTH=4000

# Job-level bounds (PART VI §6.5/§6.9)
AI_JOB_MAX_TOTAL_ATTEMPTS=18
AI_JOB_DEFAULT_BUDGET_USD=0.25

# Mini-eval acceptance target (PART IX §9.2)
AI_EVAL_MIN_VALIDITY=0.99

# HTTP provider credentials (leave empty; tests/dev use the stub)
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com