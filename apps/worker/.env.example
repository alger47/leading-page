# Worker configuration. Copy to .env for local runs.
# The engine stub provider works out of the box; no API keys needed.

# HTTP API the worker exposes (fastify).
PORT=8080

# AI Engine service (internal contract).
AI_ENGINE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=dev-internal-token

# BullMQ queue + Redis.
# Set REDIS_URL=memory:// for local dev WITHOUT a Redis server: the worker then
# uses the in-memory queue driver (same processor/retry semantics, zero install).
QUEUE_NAME=generation-jobs
REDIS_URL=redis://localhost:6379

# Timeouts / retries.
ENGINE_TIMEOUT_MS=120000
MAX_ATTEMPTS=3
RETRY_AFTER_MS=1000