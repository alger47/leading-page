# @landing-ai/web — local development defaults.
# Copy to .env.local in apps/web (or export before running) and adjust.
# Tests default to the landing_ai_test database unless DATABASE_URL says otherwise.

# Persistence (Phase 6)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/landing_ai"

# Worker API (Phase 5): the web enqueues GenerationJobs and polls status here.
WORKER_URL="http://localhost:8080"

# Session cookie
SESSION_COOKIE_NAME="sid"
SESSION_TTL_DAYS="30"

#
# --- Assets (Phase 15) ------------------------------------------------------
# Logical `asset:` refs in the envelope are resolved at PRESENTATION time by
# ui-components Render (default = self-hosted deterministic placeholder at
# /assets/asset/{ref}, CSP `img-src 'self'`-safe). To serve real images from an
# object store / CDN instead, set the public base URL and host the images at
# ${base}/{encodeURIComponent(ref)} (e.g. bucket/asset:hero-saas):
#   NEXT_PUBLIC_ASSET_S3_BASE_URL="https://cdn.example.com/assets"
# Leave unset for the local placeholder (zero-config default).

# --- API hardening (roadmap GAP-6) ------------------------------------------
# Per-IP token-bucket rate limiting on /api/v1/* (single-instance; front a
# multi-instance deploy with a CDN/API-gateway limiter instead).
#   RATE_LIMIT_CAPACITY="60"           # burst capacity
#   RATE_LIMIT_REFILL_PER_SECOND="1"   # steady refill
#   RATE_LIMIT_DISABLED="0"            # set "1" to opt out (CI/internal tools)

# --- Asset storage (roadmap GAP-6) ------------------------------------------
# Driver for the storage contract behind lib/storage.ts. Default `local`
# (filesystem under ASSET_STORAGE_DIR, served at /assets/storage/{key}).
# Set ASSET_STORAGE_DRIVER="s3" to store/retrieve in an S3-compatible object
# store via AWS SigV4 (no SDK dependency):
#   ASSET_STORAGE_DRIVER="local"
#   ASSET_STORAGE_DIR="./.local-assets"
#   ASSET_S3_BUCKET="landing-ai-assets"
#   ASSET_S3_REGION="us-east-1"
#   ASSET_S3_ACCESS_KEY_ID="..."
#   ASSET_S3_SECRET_ACCESS_KEY="..."
#   ASSET_S3_ENDPOINT=""               # S3-compatible base URL (MinIO etc.)
#   ASSET_S3_URL_TTL_SECONDS="900"     # presigned GET URL lifetime