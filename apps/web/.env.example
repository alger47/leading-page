# @landing-ai/web — local development defaults.
# Copy to .env.local in apps/web (or export before running) and adjust.
# Tests default to the landing_ai_test database unless DATABASE_URL says otherwise.

# Persistence (Phase 6)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/landing_ai"

# Worker API (Phase 5): the web enqueues GenerationJobs and polls status here.
WORKER_URL="http://localhost:8080"

# Session cookie
SESSION_COOKIE_NAME="sid"
SESSION_TTL_DAYS="30"

#
# --- Assets (Phase 15) ------------------------------------------------------
# Logical `asset:` refs in the envelope are resolved at PRESENTATION time by
# ui-components Render (default = self-hosted deterministic placeholder at
# /assets/asset/{ref}, CSP `img-src 'self'`-safe). To serve real images from an
# object store / CDN instead, set the public base URL and host the images at
# ${base}/{encodeURIComponent(ref)} (e.g. bucket/asset:hero-saas):
#   NEXT_PUBLIC_ASSET_S3_BASE_URL="https://cdn.example.com/assets"
# Leave unset for the local placeholder (zero-config default).