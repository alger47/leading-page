{
  "name": "@landing-ai/database",
  "version": "1.0.0",
  "private": true,
  "description": "PostgreSQL persistence layer: Prisma schema, forward-only migrations, tenant-scoped repositories (PART X)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "seed": "tsx prisma/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:dry-run": "tsx scripts/backup.ts --dry-run"
  },
  "dependencies": {
    "@landing-ai/page-schema": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}