{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://landing-ai-platform.com/schemas/sections/features.schema.json",
  "title": "Features Section Schema",
  "description": "Features section - showcasing product/service features",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "maxLength": 50,
      "description": "Small label above the title"
    },
    "title": {
      "type": "string",
      "maxLength": 100,
      "description": "Section title"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/FeatureItem"
      }
    },
    "media": {
      "$ref": "#/definitions/MediaRef"
    }
  },
  "definitions": {
    "FeatureItem": {
      "type": "object",
      "required": ["title", "description"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "iconRef": {
          "type": "string",
          "pattern": "^asset:"
        }
      }
    },
    "MediaRef": {
      "type": "object",
      "required": ["assetRef", "alt"],
      "additionalProperties": false,
      "properties": {
        "assetRef": {
          "type": "string",
          "pattern": "^asset:"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
