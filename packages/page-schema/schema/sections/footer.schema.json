{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://landing-ai-platform.com/schemas/sections/footer.schema.json",
  "title": "Footer Section Schema",
  "description": "Footer section - site information and links",
  "type": "object",
  "required": ["brandName", "links"],
  "additionalProperties": false,
  "properties": {
    "brandName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/FooterLink"
      }
    },
    "social": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/definitions/SocialLink"
      }
    },
    "legal": {
      "type": "string",
      "maxLength": 200,
      "description": "Legal text (copyright, etc.)"
    },
    "contact": {
      "$ref": "#/definitions/ContactInfo"
    }
  },
  "definitions": {
    "FooterLink": {
      "type": "object",
      "required": ["label", "href"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!([\\u00A0\\s]|javascript:|data:|vbscript:))",
          "description": "Navigation target; javascript:/data:/vbscript: schemes rejected at L1 (matches src/schemes.ts policy)"
        }
      }
    },
    "SocialLink": {
      "type": "object",
      "required": ["platform", "url"],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["facebook", "twitter", "instagram", "linkedin", "youtube", "tiktok"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "ContactInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "description": "Real email, OR an unmigrated draft token like [Email]. L1 checks shape only: the placeholder-aware pattern-side keeps raw SchemaBuilder drafts binding-clean; the publish gate (SEM-006) rejects any bracket token at L2 while schema-fill runs before the gate on the web side.",
          "anyOf": [
            { "format": "email" },
            { "pattern": "^\\[[A-Za-z][A-Za-z0-9 ._-]*\\]$" }
          ]
        },
        "address": {
          "type": "string"
        }
      }
    }
  }
}
